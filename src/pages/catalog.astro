---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import TrackCard from '../components/TrackCard.astro';
import headerPhoto from '../assets/photos/headphones-mic.jpg';
import { fetchCatalog } from '../lib/catalog';

// The full set of published Retro Rewind tracks, verified embeddable
// (checked via YouTube's oEmbed endpoint) 2026-08-18. Deliberately
// excludes 6 other published videos: 3 name a real artist directly
// (Fleetwood Mac / Daft Punk / Gorillaz "Era" titles) which violates the
// standing never-name-a-specific-artist guardrail (see
// workflows/daily_script_pipeline.md in youtube-content-agent) and is a
// real risk to show on a page pitching "license our original music"; 3
// more are covers/remixes of existing songs, not original compositions,
// so they don't belong on an "original, licensable" catalog either.
// No bpm/key listed - can't verify without actually analyzing the audio,
// and inventing plausible-sounding numbers on a page music supervisors
// use for real editing decisions isn't something to fake.
const curatedTracks = [
  { title: '2000s Neo-Soul, Reworked as Melodic Techno', tags: ['Neo-Soul', 'Techno', '2000s'], youtubeId: 'O0jXZ6HIFI0' },
  { title: '60s Southern Soul, Reworked as Drum & Bass', tags: ['Soul', 'Drum & Bass', '60s'], youtubeId: 'X3KI97TyQcs' },
  { title: '70s Philly Soul, Reworked as Deep House', tags: ['Soul', 'Deep House', '70s'], youtubeId: '7hLFu-iIHho' },
  { title: 'Hát Bội Opera, Reimagined as Trap', tags: ['Vietnamese', 'Trap', 'Traditional'], youtubeId: 'KN9TY3cjgdI' },
  { title: 'Hò Sông River Work Songs, Reimagined as Boom-Bap Hip-Hop', tags: ['Vietnamese', 'Hip-Hop', 'Traditional'], youtubeId: 'CA1S1jO_dxo' },
  { title: 'Vọng Cổ Ballads, Reimagined as Modern R&B', tags: ['Vietnamese', 'R&B', 'Ballad'], youtubeId: 'Rxi2BsirMS4' },
  { title: 'Hát Xẩm Street Ballads, Reimagined as Boom-Bap Hip-Hop', tags: ['Vietnamese', 'Hip-Hop', 'Traditional'], youtubeId: 'BRDy1atELZ4' },
  { title: 'Quan Họ Folk Singing, Reimagined as Modern R&B', tags: ['Vietnamese', 'R&B', 'Folk'], youtubeId: 'GditsRA95SI' },
  { title: 'Imperial Hue Court Music, Reimagined as Trap', tags: ['Vietnamese', 'Trap', 'Traditional'], youtubeId: 'Y8-_LF-GMCQ' },
  { title: 'An Ancient Vietnamese Ca Trù Chamber Piece', tags: ['Vietnamese', 'Chamber', 'Traditional'], youtubeId: 'FiliZ9hy7NI' },
  { title: 'A Golden-Era 1960s Vietnamese Bolero Ballad', tags: ['Vietnamese', 'Bolero', '60s'], youtubeId: 'xZuuM4yk5WY' },
  { title: 'A Lost 70s Laurel Canyon Folk-Rock Harmony Song', tags: ['Folk-Rock', '70s', 'Harmony'], youtubeId: 'aAUDy66_pRQ' },
  { title: 'A Lost 60s Motown-Style Soul Single', tags: ['Soul', 'Motown', '60s'], youtubeId: 'AMVpxGMsO08' },
  { title: 'A Lost 80s Japanese City Pop Night Drive Anthem', tags: ['City Pop', '80s', 'Nocturnal'], youtubeId: 'x0AAfaj-AL0' },
  { title: 'A 90s Grunge Ballad, Built From Scratch', tags: ['Grunge', '90s', 'Ballad'], youtubeId: 'XMERQpyOki8' },
  { title: 'A Golden-Era 90s Bollywood-Style Romantic Ballad', tags: ['Bollywood', '90s', 'Romantic'], youtubeId: 'ECM_1ft5g8M' },
  { title: 'A Lost 80s New Wave Synth-Pop Anthem', tags: ['Synth-Pop', '80s', 'New Wave'], youtubeId: 'YkDrm9qbMUg' },
  { title: 'A 90s R&B Slow Jam, Built From Scratch', tags: ['R&B', '90s', 'Slow Jam'], youtubeId: 'XZug3oqT0zA' },
  { title: 'The Golden Era of Sultry 70s-80s Soul & R&B', tags: ['Soul', 'R&B', '70s-80s'], youtubeId: 'mq3febWho6w' },
  { title: 'A Lost 80s Italo Disco Anthem', tags: ['Disco', '80s', 'Euphoric'], youtubeId: 'ITejVPeBs_s' },
];

// Real catalog from Supabase (see src/lib/catalog.ts) takes priority once it
// has data. Falls back to the curated YouTube-embedded picks above when the
// live catalog is empty - true as of 2026-08-18, the table was just created.
const liveCatalog = await fetchCatalog();
const usingLiveCatalog = liveCatalog.length > 0;
const tracks = usingLiveCatalog
  ? liveCatalog.map((t) => ({ title: t.title, tags: t.styleTags, audioUrl: t.audioUrl }))
  : curatedTracks;

const allTags = [...new Set(tracks.flatMap((t) => t.tags))].sort();
---

<Layout
  title="Catalog"
  description="Browse original tracks by mood, genre, and era."
>
  <section class="relative h-[40vh] min-h-[280px] overflow-hidden">
    <Image
      src={headerPhoto}
      alt="Wall of soul and jazz vinyl records in a record store"
      class="h-full w-full object-cover"
      widths={[600, 1200, 1800]}
          quality={95}
      sizes="100vw"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/50 to-ink/30"></div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-10 pt-14 md:px-10">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-brass-bright">Catalog</p>
    <h1 class="mt-6 max-w-2xl font-display text-4xl leading-tight text-paper md:text-5xl">
      A working sample of the range.
    </h1>
    <p class="mt-6 max-w-xl text-ash">
      {usingLiveCatalog
        ? 'Every track below is a real, original composition from the catalog. Filter by mood or genre to get a feel for the range, then tell us what you actually need.'
        : "This is a small preview set, not the full catalog — every project is composed fresh for its scene. Filter by mood or genre to get a feel for the range, then tell us what you actually need."}
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-24 md:px-10">
    <div id="tag-filters" class="mb-8 flex flex-wrap gap-2">
      <button
        data-tag="all"
        class="tag-btn active rounded-full border border-brass/60 bg-brass/10 px-4 py-1.5 font-mono text-[11px] uppercase tracking-[0.1em] text-brass-bright"
      >
        All
      </button>
      {allTags.map((tag) => (
        <button
          data-tag={tag}
          class="tag-btn rounded-full border border-paper/15 px-4 py-1.5 font-mono text-[11px] uppercase tracking-[0.1em] text-ash transition-colors hover:border-paper/40 hover:text-paper"
        >
          {tag}
        </button>
      ))}
    </div>
    <div id="track-grid" class="grid gap-4">
      {tracks.map((t) => (
        <div class="track-wrap" data-tags={t.tags.join('|')}>
          <TrackCard {...t} />
        </div>
      ))}
    </div>
  </section>
</Layout>

<script>
  function initFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.tag-btn');
    const items = document.querySelectorAll<HTMLElement>('.track-wrap');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => {
          b.classList.remove('active', 'bg-brass/10', 'border-brass/60', 'text-brass-bright');
          b.classList.add('border-paper/15', 'text-ash');
        });
        btn.classList.add('active', 'bg-brass/10', 'border-brass/60', 'text-brass-bright');
        btn.classList.remove('border-paper/15', 'text-ash');

        const tag = btn.dataset.tag;
        items.forEach((item) => {
          const tags = item.dataset.tags?.split('|') ?? [];
          item.style.display = tag === 'all' || tags.includes(tag ?? '') ? '' : 'none';
        });
      });
    });
  }
  document.addEventListener('astro:page-load', initFilters);
</script>
