---
import Layout from '../layouts/Layout.astro';
import Field from '../components/Field.astro';
---

<Layout
  title="Contact"
  description="Start a sync licensing project with The Shed Studio."
>
  <section class="mx-auto max-w-3xl px-6 pb-24 pt-20 md:px-10">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-brass-bright">Get in touch</p>
    <h1 class="mt-6 font-display text-4xl leading-tight text-paper md:text-5xl">
      Tell us about the project.
    </h1>
    <p class="mt-6 max-w-xl text-ash">
      Studio, timeline, budget range, what the music needs to do — the more
      you give us, the faster we can turn around something worth hearing.
      We reply to every inquiry.
    </p>

    <form
      name="project-inquiry"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="mt-14 space-y-8"
    >
      <input type="hidden" name="form-name" value="project-inquiry" />
      <p class="hidden">
        <label>Don't fill this out if you're human: <input name="bot-field" /></label>
      </p>

      <div class="grid gap-8 md:grid-cols-2">
        <Field label="Your name" name="name" required />
        <Field label="Email" name="email" type="email" required />
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        <Field label="Studio / company" name="studio" />
        <Field label="Project type" name="project_type" placeholder="Film, game, animation, trailer..." />
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        <Field label="Timeline" name="timeline" placeholder="e.g. needed in 3 weeks" />
        <Field label="Budget range" name="budget" placeholder="e.g. $500-$1500" />
      </div>
      <div>
        <label class="font-mono text-xs uppercase tracking-[0.12em] text-ash" for="message">
          Tell us about the project
        </label>
        <textarea
          id="message"
          name="message"
          rows="6"
          required
          class="mt-3 w-full border border-paper/15 bg-transparent px-4 py-3 text-paper placeholder:text-ash/50 focus:border-brass/60 focus:outline-none"
          placeholder="The scene, the mood, references you like, anything that helps us hear it before we build it."
        ></textarea>
      </div>

      <button
        type="submit"
        class="rounded-full bg-brass px-7 py-3 font-mono text-xs uppercase tracking-[0.15em] text-ink-deep transition-colors hover:bg-brass-bright"
      >
        Send inquiry
      </button>
    </form>
  </section>
</Layout>
