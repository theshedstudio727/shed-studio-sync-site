---
interface Props {
  label: string;
  name: string;
  type?: string;
  required?: boolean;
  placeholder?: string;
}

const { label, name, type = 'text', required = false, placeholder } = Astro.props;
---

<div>
  <label class="font-mono text-xs uppercase tracking-[0.12em] text-ash" for={name}>
    {label}
  </label>
  <input
    id={name}
    name={name}
    type={type}
    required={required}
    placeholder={placeholder}
    class="mt-3 w-full border border-paper/15 bg-transparent px-4 py-3 text-paper placeholder:text-ash/50 focus:border-brass/60 focus:outline-none"
  />
</div>
