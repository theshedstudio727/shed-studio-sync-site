---
const year = new Date().getFullYear();
---

<footer class="border-t border-paper/10 bg-ink-deep">
  <div class="mx-auto max-w-6xl px-6 py-14 md:px-10">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <img src="/brand/logo-paper.png" alt="The Shed Studio" class="mb-4 h-7 w-auto opacity-80" />
        <p class="max-w-xs text-sm text-ash">
          Original music, produced by a real producer, built for film, games,
          and animation.
        </p>
      </div>
      <div class="font-mono text-xs uppercase tracking-[0.15em] text-ash">
        <p class="mb-3 text-paper/60">Site</p>
        <ul class="space-y-2">
          <li><a href="/catalog" class="hover:text-paper">Catalog</a></li>
          <li><a href="/how-it-works" class="hover:text-paper">How It Works</a></li>
          <li><a href="/licensing" class="hover:text-paper">Licensing</a></li>
          <li><a href="/about" class="hover:text-paper">About</a></li>
        </ul>
      </div>
      <div class="font-mono text-xs uppercase tracking-[0.15em] text-ash">
        <p class="mb-3 text-paper/60">Get in touch</p>
        <ul class="space-y-2">
          <li><a href="/contact" class="hover:text-paper">Start a project</a></li>
          <li><a href="mailto:theshedstudio727@gmail.com" class="hover:text-paper">theshedstudio727@gmail.com</a></li>
        </ul>
      </div>
    </div>
    <p class="mt-12 font-mono text-[11px] text-ash/60">
      © {year} The Shed Studio. All rights reserved.
    </p>
  </div>
</footer>
